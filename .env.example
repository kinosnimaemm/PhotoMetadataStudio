APP_MODE=cloud
PORT=4317
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=5

# Supabase (Для API и Фронтенда)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# Paths
EXIFTOOL_BIN=exiftool
FFMPEG_BIN=ffmpeg
ZIP_BIN=zip

# Color Profiles (Linux Cloud specific)
P3_PROFILE=/app/profiles/DisplayP3.icc
SRGB_PROFILE=/app/profiles/sRGB.icc
